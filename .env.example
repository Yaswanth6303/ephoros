# Dev-only defaults. Copy to .env (git-ignored); mise loads it automatically.
APP_ENV=dev
POSTGRES_PASSWORD=ephoros-dev-only
DATABASE_URL=postgresql://ephoros:ephoros-dev-only@localhost:5432/ephoros
REDIS_URL=redis://localhost:6379/0

# auth service (Better Auth) — dev values for `just dev`; Compose overrides for the TLS stack
BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
BETTER_AUTH_URL=http://localhost:4200
