{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": false,
    "paths": {
      "@ephoros/api-contract": ["./libs/shared/api-contract/src/index.ts"],
      "@spartan-ng/helm": ["./libs/web/shared/ui/src/index.ts"],
      "@spartan-ng/helm/button": ["./libs/web/shared/ui/button/src/index.ts"],
      "@spartan-ng/helm/utils": ["./libs/web/shared/ui/utils/src/index.ts"],
      "@spartan-ng/helm/input": ["./libs/web/shared/ui/input/src/index.ts"],
      "@spartan-ng/helm/label": ["./libs/web/shared/ui/label/src/index.ts"],
      "@spartan-ng/helm/card": ["./libs/web/shared/ui/card/src/index.ts"],
      "@spartan-ng/helm/badge": ["./libs/web/shared/ui/badge/src/index.ts"],
      "@spartan-ng/helm/field": ["./libs/web/shared/ui/field/src/index.ts"],
      "@spartan-ng/helm/separator": [
        "./libs/web/shared/ui/separator/src/index.ts"
      ],
      "@ephoros/web/shared/ui/interactions": [
        "./libs/web/shared/ui/src/interactions/index.ts"
      ],
      "@ephoros/web/auth/data-access": [
        "./libs/web/auth/data-access/src/index.ts"
      ],
      "@ephoros/web/auth/feature-login": [
        "./libs/web/auth/feature-login/src/index.ts"
      ],
      "@ephoros/web/auth/domain": ["./libs/web/auth/domain/src/index.ts"],
      "@ephoros/web/shared/util": ["./libs/web/shared/util/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
