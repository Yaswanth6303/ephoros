{
  "name": "simulator",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "libs/py/simulator/src",
  "tags": ["type:app", "scope:py"],
  "namedInputs": {
    "python": [
      "{projectRoot}/**/*",
      "{workspaceRoot}/pyproject.toml",
      "{workspaceRoot}/uv.lock"
    ]
  },
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["python"],
      "options": {
        "command": "uv run pytest libs/py/simulator -q"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["python", "{workspaceRoot}/.importlinter"],
      "options": {
        "command": "uv run ruff check libs/py/simulator && uv run ruff format --check libs/py/simulator && uv run lint-imports"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["python"],
      "options": {
        "command": "uv run mypy"
      }
    }
  }
}
